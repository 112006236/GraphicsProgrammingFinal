#version 460 core
in vec2 uv;out vec4 color;
layout(binding=0)uniform sampler2D positionMap;layout(binding=1)uniform sampler2D normalMap;layout(binding=2)uniform sampler2D ambientMap;layout(binding=3)uniform sampler2D diffuseMap;layout(binding=4)uniform sampler2D specularMap;layout(binding=5)uniform sampler2DArray shadowMap;
struct Light{vec4 positionRadius;vec4 colorIntensity;};layout(std430,binding=3)readonly buffer Lights{Light lights[];};uniform int lightCount,debugMode;uniform bool shadows,cascadeColor;uniform mat4 playerView,shadowVP[3];uniform vec3 eye;
float visibility(vec3 p,vec3 n,int layer){vec4 q=shadowVP[layer]*vec4(p+n*.05,1);vec3 t=q.xyz/q.w*.5+.5;if(any(lessThan(t,vec3(0)))||any(greaterThan(t,vec3(1))))return 1.;float v=0;vec2 d=1./vec2(textureSize(shadowMap,0).xy);for(int i=-1;i<=1;i++)for(int j=-1;j<=1;j++)v+=t.z-.0008<=texture(shadowMap,vec3(t.xy+vec2(i,j)*d,layer)).r?1.:0.;return v/9.;}
void main(){vec4 p=texture(positionMap,uv);vec3 n=texture(normalMap,uv).rgb,a=texture(ambientMap,uv).rgb;vec4 d=texture(diffuseMap,uv),s=texture(specularMap,uv);if(p.a==0){color=vec4(0,0,0,1);return;}if(debugMode>0){vec3 c=debugMode==1?normalize(p.xyz)*.5+.5:debugMode==2?normalize(n)*.5+.5:debugMode==3?a:debugMode==4?d.rgb:s.rgb;color=vec4(c,1);return;}if(d.a>1.5){color=vec4(d.rgb,1);return;}n=normalize(n);vec3 L=normalize(vec3(.4,.5,.8)),V=normalize(eye-p.xyz);float depth=-(playerView*vec4(p.xyz,1)).z;int layer=depth<50?0:depth<200?1:2;float sh=shadows?visibility(p.xyz,n,layer):1.;float nl=max(dot(n,L),0);vec3 c=.2*a+sh*(.64*d.rgb*nl+.16*s.rgb*pow(max(dot(n,normalize(L+V)),0),s.a)*step(.001,nl));for(int i=0;i<lightCount;i++){vec3 delta=lights[i].positionRadius.xyz-p.xyz;float r=length(delta),rad=lights[i].positionRadius.w;if(r>=rad)continue;vec3 l=delta/max(r,.001);float f=pow(max(1-r/rad,0),2)*lights[i].colorIntensity.w/(1+r*r);c+=f*lights[i].colorIntensity.rgb*(d.rgb*max(dot(n,l),0)+s.rgb*pow(max(dot(n,normalize(l+V)),0),s.a));}if(cascadeColor)c=mix(c,layer==0?vec3(1,0,0):layer==1?vec3(0,1,0):vec3(0,0,1),.25);float fog=clamp((400-length(eye-p.xyz))/50,0,1);color=vec4(c*fog*fog,1);}
