void main(){uint id=gl_GlobalInvocationID.x;if(id>=uint(total))return;Instance a=data[id];uint t=a.info.x;if((shadowPass&&t==0)||(depthPass&&t<3))return;vec4 p=vec4(a.sphere.xyz,1);float r=a.sphere.w;for(int j=0;j<6;j++)if(dot(planes[j],p)<-r)return;if(!shadowPass&&-(view*p).z-r>400)return;if(occlusion&&t<3){vec4 q=vp*p;if(q.w>0){vec3 ndc=q.xyz/q.w;vec2 uv=ndc.xy*.5+.5;if(all(greaterThanEqual(uv,vec2(0)))&&all(lessThan(uv,vec2(1)))){float z=textureLod(pyramid,uv,float(mip)).r;vec4 nearPoint=vp*vec4(a.sphere.xyz+normalize(vec3(view[0][2],view[1][2],view[2][2]))*r,1);if(nearPoint.w>0&&nearPoint.z/nearPoint.w*.5+.5>z+.0005)return;}}}uint index=atomicAdd(cmd[t].instanceCount,1);ids[cmd[t].baseInstance+index]=id;}
